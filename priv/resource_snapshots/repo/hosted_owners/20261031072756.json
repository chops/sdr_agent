  "custom_statements": [
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP FUNCTION hosted_owners_guard()",
      "global?": false,
      "name": "hosted_owners_guard_function",
      "up": "CREATE FUNCTION hosted_owners_guard() RETURNS trigger LANGUAGE plpgsql AS $$\nBEGIN\n  IF TG_OP <> 'UPDATE' THEN\n    RAISE EXCEPTION 'hosted owner history cannot be removed' USING ERRCODE = 'restrict_violation';\n  END IF;\n  IF OLD.status <> 'active' OR NEW.status <> 'disabled'\n     OR NEW.disabled_at IS NULL\n     OR (to_jsonb(NEW) - 'status' - 'disabled_at') IS DISTINCT FROM\n        (to_jsonb(OLD) - 'status' - 'disabled_at') THEN\n    RAISE EXCEPTION 'hosted owner permits terminal disable only' USING ERRCODE = 'restrict_violation';\n  END IF;\n  RETURN NEW;\nEND;\n$$\n"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP TRIGGER hosted_owners_guard_row ON hosted_owners",
      "global?": false,
      "name": "hosted_owners_guard_row",
      "up": "CREATE TRIGGER hosted_owners_guard_row BEFORE UPDATE OR DELETE ON hosted_owners FOR EACH ROW EXECUTE FUNCTION hosted_owners_guard()"
    },
    {
      "after_tables": [],
