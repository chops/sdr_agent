    {
      "after_tables": [],
      "code?": false,
      "down": "DROP FUNCTION drafts_terminal_immutable()",
      "global?": false,
      "name": "drafts_guard_function",
      "up": "CREATE FUNCTION drafts_terminal_immutable() RETURNS trigger LANGUAGE plpgsql AS $$\nBEGIN\n  IF TG_OP <> 'UPDATE' THEN\n    RAISE EXCEPTION '% is append-only: % rejected (invocations cannot be deleted)', TG_TABLE_NAME, TG_OP\n      USING ERRCODE = 'restrict_violation';\n  END IF;\n  IF OLD.status IN ('sent', 'failed', 'rejected', 'cancelled') THEN\n    RAISE EXCEPTION '% row % is terminal: update rejected', TG_TABLE_NAME, OLD.id\n      USING ERRCODE = 'restrict_violation';\n  END IF;\n  IF (to_jsonb(NEW) - ARRAY['status', 'status_reason', 'current_revision_id', 'updated_at']) IS DISTINCT FROM (to_jsonb(OLD) - ARRAY['status', 'status_reason', 'current_revision_id', 'updated_at']) THEN\n    RAISE EXCEPTION '% row %: immutable column changed', TG_TABLE_NAME, OLD.id\n      USING ERRCODE = 'restrict_violation';\n  END IF;\n  RETURN NEW;\nEND;\n$$\n"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP TRIGGER drafts_guard_row ON drafts",
      "global?": false,
      "name": "drafts_guard_row",
      "up": "CREATE TRIGGER drafts_guard_row BEFORE UPDATE OR DELETE ON drafts FOR EACH ROW EXECUTE FUNCTION drafts_terminal_immutable()"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP TRIGGER drafts_guard_truncate ON drafts",
      "global?": false,
      "name": "drafts_guard_truncate",
      "up": "CREATE TRIGGER drafts_guard_truncate BEFORE TRUNCATE ON drafts FOR EACH STATEMENT EXECUTE FUNCTION drafts_terminal_immutable()"
    }
  ],
