      "name": "wire_witness_links_same_subject_fkey",
      "up": "ALTER TABLE wire_witness_links ADD CONSTRAINT wire_witness_links_same_subject_fkey FOREIGN KEY (tenant_id, model_invocation_id, proxy_record_ref, supersedes_id) REFERENCES wire_witness_links (tenant_id, model_invocation_id, proxy_record_ref, id) ON DELETE RESTRICT"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP FUNCTION wire_witness_links_mismatch_lineage()",
      "global?": false,
      "name": "wire_witness_links_mismatch_function",
      "up": "CREATE FUNCTION wire_witness_links_mismatch_lineage() RETURNS trigger LANGUAGE plpgsql AS $$\nDECLARE\n  previous wire_witness_links%ROWTYPE;\nBEGIN\n  IF NEW.supersedes_id IS NULL THEN\n    RETURN NEW;\n  END IF;\n  SELECT * INTO previous FROM wire_witness_links WHERE id = NEW.supersedes_id;\n  IF previous.link_status = 'mismatch' AND\n     (NEW.evidence ->> 'projection_version') IS NOT DISTINCT FROM\n     (previous.evidence ->> 'projection_version') THEN\n    RAISE EXCEPTION 'wire witness mismatch % can only be superseded under a different projection version', previous.id\n      USING ERRCODE = 'check_violation';\n  END IF;\n  RETURN NEW;\nEND;\n$$\n"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP TRIGGER wire_witness_links_mismatch_lineage ON wire_witness_links",
      "global?": false,
      "name": "wire_witness_links_mismatch_trigger",
      "up": "CREATE TRIGGER wire_witness_links_mismatch_lineage BEFORE INSERT ON wire_witness_links FOR EACH ROW EXECUTE FUNCTION wire_witness_links_mismatch_lineage()"
    }
  ],
