      "name": "webhook_events_guard_row",
      "up": "CREATE TRIGGER webhook_events_guard_row BEFORE UPDATE OR DELETE ON webhook_events FOR EACH ROW EXECUTE FUNCTION webhook_events_terminal_immutable()"
