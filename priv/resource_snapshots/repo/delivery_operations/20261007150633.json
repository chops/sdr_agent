  "custom_statements": [
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP FUNCTION delivery_operations_terminal_immutable()",
      "global?": false,
      "name": "delivery_operations_guard_function",
      "up": "CREATE FUNCTION delivery_operations_terminal_immutable() RETURNS trigger LANGUAGE plpgsql AS $$\nBEGIN\n  IF TG_OP <> 'UPDATE' THEN\n    RAISE EXCEPTION '% is append-only: % rejected (invocations cannot be deleted)', TG_TABLE_NAME, TG_OP\n      USING ERRCODE = 'restrict_violation';\n  END IF;\n  IF OLD.state IN ('failed_permanent', 'delivered', 'bounced', 'cancelled') THEN\n    RAISE EXCEPTION '% row % is terminal: update rejected', TG_TABLE_NAME, OLD.id\n      USING ERRCODE = 'restrict_violation';\n  END IF;\n  IF (to_jsonb(NEW) - ARRAY['state', 'attempt_count', 'not_before', 'attempting_at', 'accepted_at', 'confirmed_at', 'unknown_since', 'provider_message_id', 'send_quota_date', 'rendered_sha256', 'footer_template_version', 'last_error', 'last_decision_id', 'attention_failure_id', 'updated_at']) IS DISTINCT FROM (to_jsonb(OLD) - ARRAY['state', 'attempt_count', 'not_before', 'attempting_at', 'accepted_at', 'confirmed_at', 'unknown_since', 'provider_message_id', 'send_quota_date', 'rendered_sha256', 'footer_template_version', 'last_error', 'last_decision_id', 'attention_failure_id', 'updated_at']) THEN\n    RAISE EXCEPTION '% row %: immutable column changed', TG_TABLE_NAME, OLD.id\n      USING ERRCODE = 'restrict_violation';\n  END IF;\n  RETURN NEW;\nEND;\n$$\n"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP TRIGGER delivery_operations_guard_row ON delivery_operations",
      "global?": false,
      "name": "delivery_operations_guard_row",
      "up": "CREATE TRIGGER delivery_operations_guard_row BEFORE UPDATE OR DELETE ON delivery_operations FOR EACH ROW EXECUTE FUNCTION delivery_operations_terminal_immutable()"
    },
    {
