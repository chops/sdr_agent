      "global?": false,
      "name": "model_invocations_guard_row",
      "up": "CREATE TRIGGER model_invocations_guard_row BEFORE UPDATE OR DELETE ON model_invocations FOR EACH ROW EXECUTE FUNCTION model_invocations_terminal_immutable()"
    },
