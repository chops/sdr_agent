      "name": "owner_intake_origin_trigger",
      "up": "CREATE TRIGGER owner_intake_single_origin BEFORE INSERT ON owner_prospect_intakes FOR EACH ROW EXECUTE FUNCTION owner_prospect_origin_guard()"
    },
