  "custom_statements": [
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP FUNCTION approvals_terminal_immutable()",
      "global?": false,
      "name": "approvals_guard_function",
      "up": "CREATE FUNCTION approvals_terminal_immutable() RETURNS trigger LANGUAGE plpgsql AS $$\nBEGIN\n  IF TG_OP <> 'UPDATE' THEN\n    RAISE EXCEPTION '% is append-only: % rejected (invocations cannot be deleted)', TG_TABLE_NAME, TG_OP\n      USING ERRCODE = 'restrict_violation';\n  END IF;\n  IF OLD.status IN ('consumed', 'rejected', 'revoked', 'invalidated') THEN\n    RAISE EXCEPTION '% row % is terminal: update rejected', TG_TABLE_NAME, OLD.id\n      USING ERRCODE = 'restrict_violation';\n  END IF;\n  IF (to_jsonb(NEW) - ARRAY['status', 'revoked_at', 'revoked_by_id', 'invalidated_reason', 'updated_at']) IS DISTINCT FROM (to_jsonb(OLD) - ARRAY['status', 'revoked_at', 'revoked_by_id', 'invalidated_reason', 'updated_at']) THEN\n    RAISE EXCEPTION '% row %: immutable column changed', TG_TABLE_NAME, OLD.id\n      USING ERRCODE = 'restrict_violation';\n  END IF;\n  RETURN NEW;\nEND;\n$$\n"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP TRIGGER approvals_guard_row ON approvals",
      "global?": false,
      "name": "approvals_guard_row",
      "up": "CREATE TRIGGER approvals_guard_row BEFORE UPDATE OR DELETE ON approvals FOR EACH ROW EXECUTE FUNCTION approvals_terminal_immutable()"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP TRIGGER approvals_guard_truncate ON approvals",
      "global?": false,
      "name": "approvals_guard_truncate",
      "up": "CREATE TRIGGER approvals_guard_truncate BEFORE TRUNCATE ON approvals FOR EACH STATEMENT EXECUTE FUNCTION approvals_terminal_immutable()"
    }
  ],
