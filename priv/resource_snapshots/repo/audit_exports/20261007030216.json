      "after_tables": [],
      "code?": false,
      "down": "DROP FUNCTION audit_exports_terminal_immutable()",
      "global?": false,
      "name": "audit_exports_guard_function",
      "up": "CREATE FUNCTION audit_exports_terminal_immutable() RETURNS trigger LANGUAGE plpgsql AS $$\nBEGIN\n  IF TG_OP <> 'UPDATE' THEN\n    RAISE EXCEPTION '% is append-only: % rejected (invocations cannot be deleted)', TG_TABLE_NAME, TG_OP\n      USING ERRCODE = 'restrict_violation';\n  END IF;\n  IF OLD.status IN ('completed', 'failed') THEN\n    RAISE EXCEPTION '% row % is terminal: update rejected', TG_TABLE_NAME, OLD.id\n      USING ERRCODE = 'restrict_violation';\n  END IF;\n  IF (to_jsonb(NEW) - ARRAY['status', 'from_sequence', 'to_sequence', 'bundle_sha256', 'bundle_path', 'signature', 'key_id', 'assurance_level', 'anchor_ids', 'failure_reason', 'updated_at', 'trace_id', 'span_id']) IS DISTINCT FROM (to_jsonb(OLD) - ARRAY['status', 'from_sequence', 'to_sequence', 'bundle_sha256', 'bundle_path', 'signature', 'key_id', 'assurance_level', 'anchor_ids', 'failure_reason', 'updated_at', 'trace_id', 'span_id']) THEN\n    RAISE EXCEPTION '% row %: immutable column changed', TG_TABLE_NAME, OLD.id\n      USING ERRCODE = 'restrict_violation';\n  END IF;\n  RETURN NEW;\nEND;\n$$\n"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP TRIGGER audit_exports_guard_row ON audit_exports",
      "global?": false,
      "name": "audit_exports_guard_row",
      "up": "CREATE TRIGGER audit_exports_guard_row BEFORE UPDATE OR DELETE ON audit_exports FOR EACH ROW EXECUTE FUNCTION audit_exports_terminal_immutable()"
    },
