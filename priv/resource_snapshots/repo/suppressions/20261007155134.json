      "code?": false,
      "down": "DROP FUNCTION suppressions_append_only()",
      "global?": false,
      "name": "suppressions_guard_function",
      "up": "CREATE FUNCTION suppressions_append_only() RETURNS trigger LANGUAGE plpgsql AS $$\nBEGIN\n  RAISE EXCEPTION '% is append-only: % rejected', TG_TABLE_NAME, TG_OP\n    USING ERRCODE = 'restrict_violation';\nEND;\n$$\n"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP TRIGGER suppressions_guard_row ON suppressions",
      "global?": false,
      "name": "suppressions_guard_row",
      "up": "CREATE TRIGGER suppressions_guard_row BEFORE UPDATE OR DELETE ON suppressions FOR EACH ROW EXECUTE FUNCTION suppressions_append_only()"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP TRIGGER suppressions_guard_truncate ON suppressions",
      "global?": false,
      "name": "suppressions_guard_truncate",
      "up": "CREATE TRIGGER suppressions_guard_truncate BEFORE TRUNCATE ON suppressions FOR EACH STATEMENT EXECUTE FUNCTION suppressions_append_only()"
    }
