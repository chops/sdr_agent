    {
      "after_tables": [],
      "code?": false,
      "down": "ALTER TABLE leads DROP CONSTRAINT leads_admission_fkey",
      "global?": false,
      "name": "leads_admission_fkey",
      "up": "ALTER TABLE leads ADD CONSTRAINT leads_admission_fkey FOREIGN KEY (admission_id, tenant_id, account_id, contact_id) REFERENCES lead_admissions (id, tenant_id, account_id, contact_id) ON DELETE RESTRICT"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP FUNCTION leads_admission_binding()",
      "global?": false,
      "name": "leads_admission_binding_function",
      "up": "CREATE FUNCTION leads_admission_binding() RETURNS trigger LANGUAGE plpgsql AS $$\nBEGIN\n  IF NEW.source = 'fixture' AND NEW.admission_id IS NULL THEN\n    RETURN NEW;\n  END IF;\n  IF NEW.source = 'crm' OR NEW.admission_id IS NULL OR NOT EXISTS (\n       SELECT 1 FROM lead_admissions a\n        WHERE a.id = NEW.admission_id\n          AND a.tenant_id = NEW.tenant_id\n          AND a.outcome = 'admitted'\n          AND a.source_kind = NEW.source\n          AND a.referral_from_lead_id IS NOT DISTINCT FROM NEW.referred_from_lead_id) THEN\n    RAISE EXCEPTION 'leads: a new lead must be bound to its admitted admission';\n  END IF;\n  RETURN NEW;\nEND;\n$$\n"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP TRIGGER leads_admission_binding ON leads",
      "global?": false,
      "name": "leads_admission_binding",
      "up": "CREATE TRIGGER leads_admission_binding BEFORE INSERT ON leads FOR EACH ROW EXECUTE FUNCTION leads_admission_binding()"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP FUNCTION leads_identity_immutable()",
      "global?": false,
      "name": "leads_identity_immutable_function",
      "up": "CREATE FUNCTION leads_identity_immutable() RETURNS trigger LANGUAGE plpgsql AS $$\nBEGIN\n  IF NEW.source IS DISTINCT FROM OLD.source\n     OR NEW.admission_id IS DISTINCT FROM OLD.admission_id\n     OR NEW.referred_from_lead_id IS DISTINCT FROM OLD.referred_from_lead_id\n     OR NEW.account_id IS DISTINCT FROM OLD.account_id\n     OR NEW.contact_id IS DISTINCT FROM OLD.contact_id THEN\n    RAISE EXCEPTION 'leads: source, admission, referrer, account and contact are immutable';\n  END IF;\n  RETURN NEW;\nEND;\n$$\n"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP TRIGGER leads_identity_immutable ON leads",
      "global?": false,
      "name": "leads_identity_immutable",
      "up": "CREATE TRIGGER leads_identity_immutable BEFORE UPDATE ON leads FOR EACH ROW EXECUTE FUNCTION leads_identity_immutable()"
    },
