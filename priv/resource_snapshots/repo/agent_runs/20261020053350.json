      "up": "ALTER TABLE agent_runs ADD CONSTRAINT agent_runs_settings_snapshot_fkey FOREIGN KEY (settings_snapshot_id, tenant_id) REFERENCES run_settings_snapshots (id, tenant_id) ON DELETE RESTRICT"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP FUNCTION agent_runs_settings_snapshot_cutover()",
      "global?": false,
      "name": "agent_runs_settings_snapshot_cutover_function",
      "up": "CREATE FUNCTION agent_runs_settings_snapshot_cutover() RETURNS trigger LANGUAGE plpgsql AS $$\nBEGIN\n  IF TG_OP = 'INSERT' AND NEW.settings_snapshot_id IS NULL THEN\n    RAISE EXCEPTION 'agent_runs.settings_snapshot_id is required for a new run (C4 cutover)'\n      USING ERRCODE = 'restrict_violation';\n  END IF;\n  IF TG_OP = 'UPDATE' AND NEW.settings_snapshot_id IS DISTINCT FROM OLD.settings_snapshot_id THEN\n    RAISE EXCEPTION 'agent_runs.settings_snapshot_id is immutable: update rejected'\n      USING ERRCODE = 'restrict_violation';\n  END IF;\n  RETURN NEW;\nEND;\n$$\n"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP TRIGGER agent_runs_settings_snapshot_cutover ON agent_runs",
      "global?": false,
      "name": "agent_runs_settings_snapshot_cutover",
      "up": "CREATE TRIGGER agent_runs_settings_snapshot_cutover BEFORE INSERT OR UPDATE ON agent_runs FOR EACH ROW EXECUTE FUNCTION agent_runs_settings_snapshot_cutover()"
    },
