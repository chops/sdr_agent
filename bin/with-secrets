#!/usr/bin/env bash
# Run ONE child command with explicitly mapped secrets from the project sops
# file exported into its environment (ADR-0002, ADR-0004, ADR-0005).
#
#   bin/with-secrets NAME [NAME...] -- command [args...]
#
# Only names in the mapping table below are accepted. Values are decrypted
# into this process's memory with `sops -d --extract`, exported, and the child
# replaces this process via exec. Values are never echoed, logged, passed as
# argv, or written to disk.
set -euo pipefail
set +x

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
secrets_file="$root/secrets/sdr_agent.sops.yaml"

# Explicit mapping: environment variable name -> sops --extract path.
# Add entries only through a reviewed change (S14 adds SIWC entries).
secret_path() {
  case "$1" in
    SDR_AUDIT_ANCHOR_KEY_ID) printf '%s' '["audit_anchor"]["key_id"]' ;;
    SDR_AUDIT_ANCHOR_PRIVATE_KEY) printf '%s' '["audit_anchor"]["ed25519_private_key"]' ;;
    *) return 1 ;;
  esac
}

usage() {
  echo "usage: bin/with-secrets NAME [NAME...] -- command [args...]" >&2
  echo "names: SDR_AUDIT_ANCHOR_KEY_ID SDR_AUDIT_ANCHOR_PRIVATE_KEY" >&2
  exit 2
}

names=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --)
      shift
      break
      ;;
    *)
      if ! secret_path "$1" >/dev/null; then
        echo "with-secrets: unknown secret name: $1" >&2
        exit 2
      fi
      for seen in "${names[@]+"${names[@]}"}"; do
        if [ "$seen" = "$1" ]; then
          echo "with-secrets: duplicate secret name: $1" >&2
          exit 2
        fi
      done
      names+=("$1")
      shift
      ;;
  esac
done

[ "${#names[@]}" -gt 0 ] || usage
[ "$#" -gt 0 ] || usage

if [ ! -f "$secrets_file" ]; then
  echo "with-secrets: secrets file missing: secrets/sdr_agent.sops.yaml" >&2
  exit 3
fi

for name in "${names[@]}"; do
  path="$(secret_path "$name")"
  if ! value="$(sops -d --extract "$path" "$secrets_file")"; then
    echo "with-secrets: failed to decrypt $name" >&2
    exit 3
  fi
  if [ -z "$value" ]; then
    echo "with-secrets: empty value for $name" >&2
    exit 3
  fi
  export "$name=$value"
  unset value
done

exec "$@"
